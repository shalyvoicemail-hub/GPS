# Base URL of a running signal-cli-rest-api instance (see docker-compose.yml)
SIGNAL_API_URL=http://localhost:8080

# The Signal account (E.164 phone number, e.g. +15551234567) this app operates as,
# once it has been linked or registered in signal-cli-rest-api.
SIGNAL_NUMBER=

# Port this app's own web server listens on
PORT=3000

# How often (ms) to poll signal-cli-rest-api for new incoming messages
RECEIVE_POLL_INTERVAL_MS=3000
